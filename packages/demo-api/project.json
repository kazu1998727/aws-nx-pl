{
  "name": "@aws-nx-pl/demo-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/demo-api/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#trpc-api",
    "ports": [2022],
    "apiName": "demo-api",
    "apiType": "trpc",
    "auth": "iam",
    "infra": "rest-lambda",
    "integrationPattern": "isolated",
    "iac": "cdk"
  },
  "targets": {
    "assemble": {
      "dependsOn": ["compile", "bundle"]
    },
    "build": {
      "dependsOn": ["lint", "compile", "test", "bundle"]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["tsx --watch src/local-server.ts"],
        "cwd": "{projectRoot}",
        "env": {
          "LOCAL_DEV": "true"
        }
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "dependsOn": ["format"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["tsx --watch src/local-server.ts"],
        "cwd": "{projectRoot}"
      }
    }
  }
}
