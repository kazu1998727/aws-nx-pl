{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@aws-nx-pl/source"
    ],
    "rootDir": ".",
    "paths": {
      "@aws-nx-pl/demo-api": [
        "./packages/demo-api/src/index.ts"
      ],
      "@aws-nx-pl/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ],
      "@aws-nx-pl/demo-website": [
        "./packages/demo-website/src/index.ts"
      ],
      "@aws-nx-pl/common-shadcn": [
        "./packages/common/shadcn/src/index.ts"
      ],
      "@aws-nx-pl/infra": [
        "./packages/infra/src/index.ts"
      ]
    }
  }
}
